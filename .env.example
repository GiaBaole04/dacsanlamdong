# Sao chép file này thành ".env" rồi điền giá trị thật. KHÔNG đưa file ".env" lên GitHub.

# --- Cơ sở dữ liệu MariaDB / MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dacsanlamdong

# --- Đăng nhập: chuỗi ngẫu nhiên dài ít nhất 32 ký tự ---
JWT_SECRET=

# --- Gửi email OTP và xác nhận đơn hàng (Gmail + "Mật khẩu ứng dụng") ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Địa chỉ website, dùng để gắn liên kết trong email (tùy chọn)
SITE_URL=http://localhost:3000

# --- Thanh toán chuyển khoản (mã QR VietQR) ---
SHOP_BANK_NAME=
SHOP_BANK_BIN=
SHOP_BANK_ACCOUNT=
SHOP_BANK_ACCOUNT_NAME=

# --- Chatbot tư vấn (Google Gemini) ---
GEMINI_API_KEY=
# Tùy chọn: đổi mô hình nếu tên mặc định không còn dùng được
# GEMINI_MODEL=gemini-3.5-flash-lite
# Tùy chọn: giới hạn số câu hỏi (mặc định 12 câu / 10 phút / địa chỉ và 300 câu / ngày)
# CHAT_IP_LIMIT=12
# CHAT_DAILY_LIMIT=300
